]


### ============================================================
### GET /share-of-voice
### Marca existente
### ============================================================

GET {{baseUrl}}/share-of-voice?marca=Acme
Accept: application/json


### ============================================================
### GET /share-of-voice
### Marca em minúsculo
### ============================================================

GET {{baseUrl}}/share-of-voice?marca=acme
Accept: application/json


### ============================================================
### GET /share-of-voice
### Marca em maiúsculo
### ============================================================

GET {{baseUrl}}/share-of-voice?marca=ACME
Accept: application/json


### ============================================================
### GET /share-of-voice
### Marca inexistente
### ============================================================

GET {{baseUrl}}/share-of-voice?marca=MarcaInexistente
Accept: application/json


### ============================================================
### GET /share-of-voice
### Sem parâmetro marca
### Deve retornar 422
### ============================================================

GET {{baseUrl}}/share-of-voice
Accept: application/json


### ============================================================
### GET /top-citacoes
### Valor padrão: n = 5
### ============================================================

GET {{baseUrl}}/top-citacoes
Accept: application/json


### ============================================================
### GET /top-citacoes
### n = 3
### ============================================================

GET {{baseUrl}}/top-citacoes?n=3
Accept: application/json


### ============================================================
### GET /top-citacoes
### n = 1
### ============================================================

GET {{baseUrl}}/top-citacoes?n=1
Accept: application/json


### ============================================================
### GET /top-citacoes
### n = 10
### ============================================================

GET {{baseUrl}}/top-citacoes?n=10
Accept: application/json


### ============================================================
### GET /top-citacoes
### n inválido
### Deve retornar 422 porque n >= 1
### ============================================================

GET {{baseUrl}}/top-citacoes?n=0
Accept: application/json


### ============================================================
### GET /top-citacoes
### n negativo
### Deve retornar 422
### ============================================================

GET {{baseUrl}}/top-citacoes?n=-1
Accept: application/json


### ============================================================
### GET /top-citacoes
### n não numérico
### Deve retornar 422
### ============================================================

GET {{baseUrl}}/top-citacoes?n=abc
Accept: application/json
